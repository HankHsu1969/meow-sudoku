{
  "name": "meow-sudoku",
  "version": "1.0.0",
  "private": true,
  "description": "喵喵數獨：可愛貓咪主題數獨，50 關，合成音樂與音效",
  "scripts": {
    "ios:add": "cap add ios",
    "ios:assets": "capacitor-assets generate --ios",
